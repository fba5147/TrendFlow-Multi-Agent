# ─── Convex (required) ─────────────────────────────────────────────────────────
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_URL=https://your-deployment.convex.cloud

# ─── LLM Provider (choose one) ─────────────────────────────────────────────────
# Provider: groq | openai | anthropic | gemini | deepseek | ollama  (default: groq)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Groq — free tier available: console.groq.com
GROQ_API_KEY=your-groq-api-key

# OpenAI — requires: npm install @langchain/openai
# OPENAI_API_KEY=your-openai-api-key

# Anthropic — requires: npm install @langchain/anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini — requires: npm install @langchain/google-genai
# GOOGLE_API_KEY=your-google-api-key

# DeepSeek — requires: npm install @langchain/openai
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Ollama (local) — requires: npm install @langchain/ollama  + Ollama running locally
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Source Plugins ─────────────────────────────────────────────────────────────
# Brave Search (via MCP server) — brave.com/search/api
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=-y,@modelcontextprotocol/server-brave-search
BRAVE_API_KEY=your-brave-api-key

# GitHub (optional — increases rate limits from 60 to 5000 req/hr)
# GITHUB_TOKEN=your-github-token

# News API — newsapi.org
# NEWS_API_KEY=your-newsapi-key

# RSS Feeds — comma-separated URLs (no auth required)
# RSS_FEEDS=https://hnrss.org/frontpage,https://feeds.arstechnica.com/arstechnica/index

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
